---
import CustomSEO from "@components/ui/SEO.astro";
import Footer from "@components/footer.astro";
import Navbar from "@components/navbar/navbar.astro";
import BackToTop from "@components/ui/BackToTop.astro";
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/inter";
import "../styles/premium.css";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: string;
  heroImage?: string;
  heroImageSet?: string;
  heroImageSizes?: string;
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  ogType,
  heroImage,
  heroImageSet,
  heroImageSizes,
  author,
  publishedTime,
  modifiedTime,
  section,
  noindex,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
    <CustomSEO 
      title={title} 
      description={description} 
      image={image} 
      ogType={ogType} 
      author={author}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      section={section}
      noindex={noindex}
    />
    {heroImage && (
      <link
        rel="preload"
        as="image"
        href={heroImage}
        imagesrcset={heroImageSet}
        imagesizes={heroImageSizes}
        fetchpriority="high"
      />
    )}
    <slot name="head" />
    <style is:global>
      html, body { overflow-x: clip; }
    </style>
    <script is:inline>
      // Satu definisi untuk seluruh halaman. Sebelumnya script ini menempel di
      // komponen ThemeToggle yang dirender dua kali (mobile + desktop), jadi
      // fungsi yang sama dikirim dan diparse dua kali.
      function setupThemeToggle() {
        const btns = document.querySelectorAll('.theme-toggle-btn');
        if (!btns.length) return;
        function updateIcons() {
          const isDark = document.documentElement.classList.contains('dark');
          btns.forEach((btn) => {
            btn.querySelector('.theme-toggle-dark-icon')?.classList.toggle('hidden', isDark);
            btn.querySelector('.theme-toggle-light-icon')?.classList.toggle('hidden', !isDark);
          });
        }
        updateIcons();
        btns.forEach((btn) => {
          btn.onclick = function () {
            document.documentElement.classList.toggle('dark');
            const isDark = document.documentElement.classList.contains('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            updateIcons();
          };
        });
      }
      // Tunggu DOMContentLoaded agar tombol versi mobile DAN desktop sudah ada.
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupThemeToggle);
      } else {
        setupThemeToggle();
      }
      document.addEventListener('astro:after-swap', setupThemeToggle);
    </script>
  </head>
  <body class="bg-brutal-bg text-brutal-text">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>
