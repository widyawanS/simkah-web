---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import AdSlot from "@components/ui/AdSlot.astro";
import { SITE, WEBSITE_ID, toJsonLd } from "@lib/site";
import wilayahData from "../../data/wilayah.json";

const totalKecamatan = wilayahData.length;

const pageJsonLd = toJsonLd({
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Panduan Nikah di KUA — Cari Kecamatan",
  description: `Cari panduan lengkap daftar nikah di KUA kecamatan Anda dari ${totalKecamatan} kecamatan di seluruh Indonesia. Syarat, alur, biaya, dan jadwal resmi.`,
  url: `${SITE.url}/panduan-nikah-di-KUA`,
  isPartOf: { "@id": WEBSITE_ID },
  inLanguage: "id-ID",
});
---

<Layout
  title="Panduan Nikah di KUA — Cari Kecamatan Anda"
  description={`Cari panduan lengkap daftar nikah di KUA kecamatan Anda dari ${totalKecamatan} kecamatan di seluruh Indonesia. Syarat, alur, biaya, dan jadwal resmi berdasarkan Permenag No. 30 Tahun 2024.`}
>
  <script type="application/ld+json" slot="head" set:html={pageJsonLd} />

  <Container>
    <div class="max-w-4xl mx-auto mb-20">
      <!-- Header -->
      <div class="text-center mb-12 mt-12 flex flex-col items-center">
        <span class="inline-block px-4 py-2 brutal-badge bg-emerald-200 text-brutal-text text-sm font-bold mb-4 border-2 border-brutal-border">
          🕌 Panduan per Kecamatan
        </span>
        <h1 class="text-3xl md:text-5xl font-black text-brutal-text text-center mb-4 drop-shadow-md">
          Cari <span class="text-emerald-600">KUA Kecamatan</span> Anda
        </h1>
        <p class="text-center text-brutal-text-muted max-w-2xl mx-auto mb-8 text-lg font-medium">
          Panduan lengkap syarat, alur, biaya, dan jadwal pendaftaran nikah di{" "}
          <strong>{totalKecamatan.toLocaleString("id-ID")}</strong> kecamatan
          seluruh Indonesia — sesuai Permenag No. 30 Tahun 2024.
        </p>
        <AdSlot type="tools" />
      </div>

      <!-- Search Box -->
      <div class="brutal-card bg-[#c0e6ff] dark:bg-brutal-card rounded-3xl p-6 md:p-8 mb-8">
        <label for="searchInput" class="block text-brutal-text font-bold text-lg mb-3">
          🔍 Ketik nama kecamatan atau kota/kabupaten:
        </label>
        <input
          id="searchInput"
          type="search"
          placeholder="Contoh: Lowokwaru, Kebayoran Baru, Medan Kota…"
          autocomplete="off"
          class="w-full px-5 py-4 text-lg font-semibold rounded-2xl border-2 border-brutal-border bg-white text-brutal-text placeholder:text-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 transition"
        />
        <p id="searchHint" class="mt-3 text-sm text-brutal-text-muted font-medium">
          Mulai ketik untuk mencari…
        </p>
      </div>

      <!-- Results -->
      <div id="resultsList" class="grid gap-3 md:grid-cols-2" aria-live="polite"></div>

      <!-- Empty state -->
      <div id="emptyState" class="hidden text-center py-12">
        <p class="text-2xl mb-2">🤔</p>
        <p class="text-brutal-text font-semibold">Kecamatan tidak ditemukan.</p>
        <p class="text-brutal-text-muted text-sm mt-1">Coba nama kecamatan atau kota yang lebih singkat.</p>
      </div>

      <!-- Info -->
      <div class="mt-12 brutal-card bg-[#fae870] dark:bg-brutal-card rounded-2xl p-6">
        <h2 class="font-bold text-brutal-text text-lg mb-2">ℹ️ Tentang halaman ini</h2>
        <p class="text-brutal-text-muted text-sm leading-relaxed">
          Setiap halaman kecamatan memuat syarat dokumen, alur pendaftaran, estimasi biaya, dan
          informasi KUA setempat berdasarkan <strong>Permenag No. 30 Tahun 2024</strong> dan
          <strong>Kepdirjen Bimas Islam No. 888 Tahun 2026</strong>. Data wilayah mencakup
          {totalKecamatan.toLocaleString("id-ID")} kecamatan dari 38 provinsi di Indonesia.
        </p>
      </div>
    </div>
  </Container>
</Layout>

<script>
  // Embed data wilayah ringkas (hanya slug, kecamatan, kota) untuk search
  const rawData: Array<{ slug: string; kecamatan: string; kota: string; provinsi: string }> =
    (window as any).__wilayahIndex__ || [];

  const input = document.getElementById("searchInput") as HTMLInputElement;
  const hint = document.getElementById("searchHint") as HTMLParagraphElement;
  const list = document.getElementById("resultsList") as HTMLDivElement;
  const empty = document.getElementById("emptyState") as HTMLDivElement;

  let debounceTimer: ReturnType<typeof setTimeout>;

  function render(items: typeof rawData) {
    list.innerHTML = "";
    empty.classList.add("hidden");

    if (items.length === 0) {
      empty.classList.remove("hidden");
      return;
    }

    items.slice(0, 30).forEach((item) => {
      const a = document.createElement("a");
      a.href = `/panduan-nikah-di-KUA/${item.slug}`;
      a.className =
        "group flex items-center justify-between gap-3 px-5 py-4 rounded-2xl border-2 border-brutal-border bg-white hover:bg-emerald-50 hover:border-emerald-500 transition font-semibold text-brutal-text";
      a.innerHTML = `
        <span>
          <span class="block text-base">${item.kecamatan}</span>
          <span class="block text-xs text-brutal-text-muted font-normal mt-0.5">${item.kota}, ${item.provinsi}</span>
        </span>
        <span class="text-emerald-600 group-hover:translate-x-1 transition-transform">→</span>
      `;
      list.appendChild(a);
    });

    if (items.length > 30) {
      const note = document.createElement("p");
      note.className = "col-span-2 text-center text-sm text-brutal-text-muted mt-2";
      note.textContent = `Menampilkan 30 dari ${items.length} hasil. Perjelas kata kunci untuk hasil lebih spesifik.`;
      list.appendChild(note);
    }
  }

  input.addEventListener("input", () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      const q = input.value.trim().toLowerCase();
      if (q.length < 2) {
        list.innerHTML = "";
        empty.classList.add("hidden");
        hint.textContent = "Mulai ketik untuk mencari…";
        return;
      }
      const results = rawData.filter(
        (d) =>
          d.kecamatan.toLowerCase().includes(q) ||
          d.kota.toLowerCase().includes(q) ||
          d.provinsi.toLowerCase().includes(q)
      );
      hint.textContent =
        results.length > 0
          ? `${results.length} kecamatan ditemukan`
          : "Tidak ada hasil";
      render(results);
    }, 200);
  });
</script>

<!-- Inject data wilayah ringkas sebagai JSON inline (search berjalan di client) -->
<script
  is:inline
  define:vars={{
    wilayahIndex: wilayahData.map((d: { slug: string; kecamatan: string; kota: string; provinsi: string }) => ({
      slug: d.slug,
      kecamatan: d.kecamatan,
      kota: d.kota,
      provinsi: d.provinsi,
    })),
  }}
>
  window.__wilayahIndex__ = wilayahIndex;
  // Trigger re-init after page load (script order safety)
  document.addEventListener("DOMContentLoaded", () => {
    const script = document.querySelector("script[type='module'][src*='index']");
    // Data already set above; nothing else needed
  });
</script>

