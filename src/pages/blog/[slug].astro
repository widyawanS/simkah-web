---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import TableOfContents from "@components/blog/TableOfContents.astro";
import SocialShare from "@components/blog/SocialShare.astro";
import AdSlot from "@components/ui/AdSlot.astro";
import { getPostBySlug, getPosts } from "@lib/content";
import { getViewCounts } from "@lib/views";
import { marked } from "marked";
import blogImages from "../../data/blog-images";
import { Image } from "astro:assets";
import {
  SITE,
  AUTHOR,
  ORG_ID,
  PERSON_ID,
  absoluteUrl,
  toJsonLd,
} from "@lib/site";

const { slug } = Astro.params;
const post = await getPostBySlug(slug as string);

if (!post || post.draft) {
  return Astro.redirect("/404");
}

const contentHtml = marked.parse(post.content);
const firstParagraphEnd = contentHtml.indexOf('</p>');
const introHtml = firstParagraphEnd > -1 ? contentHtml.slice(0, firstParagraphEnd + 4) : contentHtml;
const bodyHtml = firstParagraphEnd > -1 ? contentHtml.slice(firstParagraphEnd + 4) : '';

const allPosts = await getPosts();
const relatedPosts = allPosts
  .filter(p => p.slug !== slug && p.category === post.category)
  .slice(0, 4);

const viewCounts = getViewCounts();
const popularPosts = allPosts
  .filter((p) => (viewCounts[p.slug] || 0) > 0)
  .sort((a, b) => (viewCounts[b.slug] || 0) - (viewCounts[a.slug] || 0))
  .slice(0, 5);
const recentPosts = allPosts.filter((p) => p.slug !== post.slug).slice(0, 5);

const postUrl = new URL(`/blog/${post.slug}`, SITE.url).toString();
// Hero: pakai varian responsif kalau manifest punya entrinya.
// 896px = lebar maksimum kolom artikel (max-w-4xl).
const HERO_SIZES = "(min-width: 1024px) 700px, 100vw";
const heroSrc: string | null =
  typeof post.image === "string" && post.image.startsWith("/images/blog/") ? post.image : null;
const heroMeta = heroSrc ? (blogImages[heroSrc] ?? null) : null;
const heroSrcSet =
  heroSrc && heroMeta && heroMeta.variants.length > 0
    ? heroMeta.variants
        .map((w) => `${heroSrc.replace(/\.[a-z0-9]+$/i, `-${w}.webp`)} ${w}w`)
        .join(", ")
    : undefined;
const publishedIso = post.pubDate.toISOString();
const modifiedDate =
  post.updatedDate && post.updatedDate.getTime() > post.pubDate.getTime()
    ? post.updatedDate
    : post.pubDate;
const modifiedIso = modifiedDate.toISOString();
const isUpdated = modifiedIso !== publishedIso;

/** Ambil FAQ dari section "## Pertanyaan umum" / "## FAQ" dengan format **Tanya** + jawaban. */
function extractFaq(md: string): { q: string; a: string }[] {
  const section = md.match(/##\s*(?:Pertanyaan umum|FAQ)\s*([\s\S]*?)(?=\n##\s|\n#\s|$)/i);
  if (!section) return [];

  const items: { q: string; a: string }[] = [];
  const re = /\*\*(.+?)\*\*\s*\n([\s\S]*?)(?=\n\*\*|\n#{2,}\s|$)/g;
  let match: RegExpExecArray | null;
  while ((match = re.exec(section[1])) !== null) {
    const q = match[1].replace(/\s+/g, " ").trim();
    const a = match[2].replace(/\s+/g, " ").trim();
    if (q && a) items.push({ q, a });
  }
  return items;
}

const faqItems = extractFaq(post.content);

const graph: Record<string, unknown>[] = [
  {
    "@type": "BlogPosting",
    "@id": `${postUrl}#article`,
    headline: post.title,
    description: post.description,
    image: [absoluteUrl(post.image)],
    datePublished: publishedIso,
    dateModified: modifiedIso,
    inLanguage: SITE.language,
    articleSection: post.category,
    isAccessibleForFree: true,
    author: { "@id": PERSON_ID },
    publisher: { "@id": ORG_ID },
    mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${postUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Beranda", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE.url}/blog` },
      { "@type": "ListItem", position: 3, name: post.title, item: postUrl },
    ],
  },
  {
    "@type": "Person",
    "@id": PERSON_ID,
    name: AUTHOR.name,
    alternateName: AUTHOR.alternateName,
    jobTitle: AUTHOR.jobTitle,
    url: AUTHOR.url,
    image: AUTHOR.image,
  },
];

if (faqItems.length > 0) {
  graph.push({
    "@type": "FAQPage",
    "@id": `${postUrl}#faq`,
    mainEntity: faqItems.map(({ q, a }) => ({
      "@type": "Question",
      name: q,
      acceptedAnswer: { "@type": "Answer", text: a },
    })),
  });
}

const postJsonLd = toJsonLd({ "@context": "https://schema.org", "@graph": graph });
---

<Layout 
  title={post.title} 
  description={post.description} 
  image={post.image}
  ogType="article"
  author={AUTHOR.name}
  publishedTime={publishedIso}
  modifiedTime={modifiedIso}
  section={post.category}
  heroImage={heroMeta ? heroSrc : undefined}
  heroImageSet={heroSrcSet}
  heroImageSizes={heroMeta ? HERO_SIZES : undefined}
>
  <script type="application/ld+json" slot="head" set:html={postJsonLd} />
  <script is:inline define:vars={{ viewSlug: post.slug }}>
    (function () {
      var key = 'simkah-view:' + viewSlug;
      try {
        if (sessionStorage.getItem(key)) return;
        sessionStorage.setItem(key, '1');
      } catch (e) {}
      fetch('/api/views/' + encodeURIComponent(viewSlug), { method: 'POST', keepalive: true }).catch(function () {});
    })();
  </script>
  <Container>
    <article class="mx-auto max-w-5xl mt-16 animate-fade-in">
        <div class="grid lg:grid-cols-[1fr_280px] gap-12">
          <!-- Main Content -->
          <div>
            <nav class="breadcrumb flex flex-wrap justify-center items-center gap-2 text-sm text-brutal-text-muted mb-6" aria-label="Breadcrumb">
              <a href="/" class="hover:text-brutal-text">Beranda</a>
              <span aria-hidden="true">/</span>
              <a href="/blog" class="hover:text-brutal-text">Artikel</a>
              <span aria-hidden="true">/</span>
              <span aria-current="page">{post.category}</span>
            </nav>

            <header class="text-center mb-10 w-full">
                <h1 class="text-3xl md:text-4xl font-bold mb-8 leading-tight dark:text-white">
                    {post.title}
                </h1>
                <div class="flex items-center justify-center gap-4 text-slate-500 dark:text-slate-400">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg border-2 border-brutal-border bg-brutal-warning flex items-center justify-center text-lg font-bold text-brutal-on-bright shadow-brutal-sm -rotate-3 hover:rotate-3 transition-transform cursor-default">
                            {post.author[0]}
                        </div>
                        <span class="text-slate-900 dark:text-white font-extrabold text-lg">{post.author}</span>
                    </div>
                    <span>•</span>
                    <time datetime={post.pubDate.toISOString()}>
                        {post.pubDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}
                    </time>
                    {isUpdated && (
                        <>
                            <span>•</span>
                            <span>
                                Diperbarui {modifiedDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}
                            </span>
                        </>
                    )}
                </div>
            </header>

            {post.image && (
                <div class="w-full aspect-video rounded-brutal overflow-hidden mb-10 glass shadow-2xl bg-slate-900">
                    {heroMeta ? (
                        <img
                            src={post.image}
                            srcset={heroSrcSet}
                            sizes={HERO_SIZES}
                            width={heroMeta.w}
                            height={heroMeta.h}
                            class="w-full h-full object-cover"
                            alt={post.title}
                            loading="eager"
                            fetchpriority="high"
                            decoding="async"
                        />
                    ) : (
                        <img src={post.image} class="w-full h-full object-cover" alt={post.title} loading="eager" fetchpriority="high" decoding="async" />
                    )}
                </div>
            )}

            <SocialShare title={post.title} url={postUrl} />

            <TableOfContents />

            <div class="prose dark:prose-invert prose-indigo prose-lg max-w-none prose-h2:text-2xl prose-h2:font-bold prose-p:text-slate-600 dark:prose-p:text-slate-300 prose-p:leading-loose prose-a:text-brand-primary">
                <Fragment set:html={introHtml} />
            </div>

            <AdSlot type="post-2" class="my-8" />

            {bodyHtml && (
              <div class="prose dark:prose-invert prose-indigo prose-lg max-w-none prose-h2:text-2xl prose-h2:font-bold prose-p:text-slate-600 dark:prose-p:text-slate-300 prose-p:leading-loose prose-a:text-brand-primary">
                <Fragment set:html={bodyHtml} />
              </div>
            )}

            <SocialShare title={post.title} url={postUrl} />

            <!-- Author Bio (E-E-A-T) -->
            <div class="mt-12 grid sm:grid-cols-[auto,1fr] gap-5 p-6 rounded-2xl border-2 border-brutal-border bg-brutal-card shadow-brutal-sm">
              <div class="w-14 h-14 rounded-xl border-2 border-brutal-border bg-brutal-warning flex items-center justify-center text-xl font-bold text-brutal-on-bright shadow-brutal-sm -rotate-3">
                W
              </div>
              <div>
                <p class="font-extrabold text-brutal-text">
                  Ditulis oleh <a href="/about" class="underline decoration-2 underline-offset-2 hover:text-brand-primary">Widyawan Sigitmanto</a>
                </p>
                <p class="text-sm text-brutal-text-muted mt-1 leading-relaxed">
                  Penghulu dan penulis simkah.web.id. Artikel disusun dari pengalaman verifikasi berkas di KUA serta merujuk Permenag No. 30/2024 dan Kepdirjen No. 888/2026.
                </p>
              </div>
            </div>

            <!-- Internal links ke tools -->
            <div class="tools-callout mt-8 p-6 rounded-2xl border-2 border-brutal-border">
              <h3 class="font-extrabold mb-3 text-brutal-text">Alat bantu gratis</h3>
              <div class="flex flex-wrap gap-2 text-sm font-bold">
                <a href="/tools/kalkulator-wedding" class="brutal-pill px-4 py-2 hover:bg-white transition-colors">Kalkulator Wedding</a>
                <a href="/tools/skrining-catin" class="brutal-pill px-4 py-2 hover:bg-white transition-colors">Skrining Catin</a>
                <a href="/tools/kalkulator-keluarga" class="brutal-pill px-4 py-2 hover:bg-white transition-colors">Kalkulator Keluarga</a>
              </div>
            </div>

            <!-- Related Posts Section -->
            {relatedPosts.length > 0 && (
              <div class="mt-16">
                <h3 class="text-2xl font-extrabold mb-6 text-brutal-text">Artikel Terkait</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  {relatedPosts.map((p, index) => (
                    <article class={`related-post related-post--${(index % 3) + 1}`}>
                      <a href={`/blog/${p.slug}`} class="related-post__link">
                        {p.image && (
                          typeof p.image === 'string' ? (
                            <img src={p.image} width={blogImages[p.image]?.w ?? 1200} height={blogImages[p.image]?.h ?? 675} class="related-post__img" alt={p.title} loading="lazy" />
                          ) : (
                            <Image src={p.image} class="related-post__img" alt={p.title} loading="lazy" width={400} height={225} />
                          )
                        )}
                        <div class="related-post__body">
                          <h4>{p.title.length > 78 ? p.title.slice(0, 78).trimEnd() + '…' : p.title}</h4>
                        </div>
                      </a>
                    </article>
                  ))}
                </div>
              </div>
            )}

            <!-- Ad B: above the footer line -->
            <AdSlot type="post" class="my-10" />
          </div>

          <!-- Sidebar: two widgets only -->
          <aside class="hidden lg:block">
            <div class="sticky top-24 space-y-10">
              <div class="sidebar-widget">
                <h3 class="text-base font-extrabold mb-4">Post Terbaru</h3>
                <ul class="space-y-3">
                  {recentPosts.map((p) => (
                    <li>
                      <a href={`/blog/${p.slug}`} class="flex items-center gap-3 group">
                        <span class="recent-thumb">
                          {p.image ? (
                            typeof p.image === 'string' ? (
                              <img src={p.image} width={48} height={48} class="w-full h-full object-cover" alt="" loading="lazy" decoding="async" />
                            ) : (
                              <Image src={p.image} width={48} height={48} class="w-full h-full object-cover" alt="" loading="lazy" decoding="async" />
                            )
                          ) : null}
                        </span>
                        <span class="text-xs text-brutal-text group-hover:underline leading-snug">{p.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="sidebar-widget">
                <h3 class="text-base font-extrabold mb-4">Post yang Sering Dibaca</h3>
                {popularPosts.length > 0 ? (
                  <ol class="space-y-3">
                    {popularPosts.map((p, i) => (
                      <li class="flex gap-3 text-sm">
                        <span class="num text-brutal-primary font-bold">#{i + 1}</span>
                        <a href={`/blog/${p.slug}`} class="text-brutal-text hover:underline leading-snug">{p.title}</a>
                      </li>
                    ))}
                  </ol>
                ) : (
                  <p class="text-sm text-brutal-text-muted">Peringkat muncul setelah artikel mulai dibaca.</p>
                )}
              </div>
            </div>
          </aside>
        </div>

    </article>
  </Container>
</Layout>

<style is:global>
    .prose h2, .prose h3 {
        margin-top: 2.5rem;
        margin-bottom: 1.5rem;
        scroll-margin-top: 100px;
        text-wrap: balance;
    }
    .prose p {
        margin-bottom: 1.5rem;
    }
</style>

