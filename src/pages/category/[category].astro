---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import PostCard from "@components/blog/PostCard.astro";
import AdSlot from "@components/ui/AdSlot.astro";
import { getPostsByCategory } from "@lib/content.ts";

const { category } = Astro.params;
const cat = category as string;
const allPosts = await getPostsByCategory(cat);

const pageSize = 6;
const catPages = [];
for (let i = 0; i < allPosts.length; i += pageSize) {
  catPages.push(allPosts.slice(i, i + pageSize));
}
const totalCatPages = catPages.length;

const displayCategory =
  allPosts[0]?.category ||
  cat
    .split('-')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
---

<Layout title={`${displayCategory} | Archive`}>
  <Container>
    <main class="py-20 animate-fade-in">
      <header class="text-center mb-16">
        <h1 class="text-5xl font-bold mb-4 tracking-tighter">Kategori: <span class="text-gradient">{displayCategory}</span></h1>
        <p class="text-brutal-text-muted max-w-xl mx-auto text-lg">Menampilkan semua tulisan dalam kategori {displayCategory}.</p>
      </header>

      <div class="category-pages">
        {catPages.map((pagePosts, pageIndex) => (
          <div class="guide-posts" data-cat-page={pageIndex + 1} hidden={pageIndex > 0}>
            {pagePosts.map((post, index) => (
              <PostCard post={post} index={index} compact />
            ))}
          </div>
        ))}
      </div>

      {allPosts.length > 0 && (
        <div id="cat-ad-1" class="feed-ad">
          <AdSlot type="home-2" />
        </div>
      )}

      {allPosts.length === 0 && (
        <div class="text-center py-32 glass rounded-[3rem] border border-dashed border-slate-300 dark:border-slate-800">
          <p class="text-slate-500 italic text-lg">Belum ada artikel dalam kategori ini.</p>
          <a href="/" class="mt-6 inline-block text-brand-primary font-bold hover:underline">Kembali ke Beranda</a>
        </div>
      )}

      {totalCatPages > 1 && (
        <nav class="news-pagination mt-10 flex flex-wrap items-center justify-center gap-2" aria-label="Halaman artikel">
          <span class="flex flex-wrap items-center justify-center gap-2" data-cat-pages></span>
          <span class="visually-hidden" role="status" aria-live="polite" data-cat-status>Halaman 1 dari {totalCatPages}</span>
        </nav>
      )}

      {allPosts.length > 0 && (
        <div id="cat-ad-2" class="feed-ad">
          <AdSlot type="home" />
        </div>
      )}
    </main>
  </Container>
</Layout>

<script>
  const catPageEls = Array.from(document.querySelectorAll('[data-cat-page]'));
  const catStatus = document.querySelector('[data-cat-status]');
  const catPagesBox = document.querySelector('[data-cat-pages]');
  let catCurrent = 1;

  function renderCatNumbers() {
    if (!catPagesBox) return;
    const total = catPageEls.length;
    let items;
    if (total <= 4) {
      items = Array.from({ length: total }, (_, i) => i + 1);
    } else if (catCurrent <= 2) {
      items = [1, 2, 3, 'gap', total];
    } else if (catCurrent >= total - 2) {
      items = [1, 'gap', total - 2, total - 1, total];
    } else {
      items = [1, catCurrent, catCurrent + 1, 'gap', total];
    }
    let html = '';
    for (const item of items) {
      if (item === 'gap') html += '<span class="page-gap" aria-hidden="true">…</span>';
      else html += `<button type="button" class="page-num${item === catCurrent ? ' is-current' : ''}" data-cat-go="${item}"${item === catCurrent ? ' aria-current="page"' : ''}>${item}</button>`;
    }
    catPagesBox.innerHTML = html;
  }

  function showCatPage(n) {
    catCurrent = Math.min(Math.max(n, 1), catPageEls.length);
    catPageEls.forEach((el, i) => { el.hidden = i + 1 !== catCurrent; });
    if (catStatus) catStatus.textContent = `Halaman ${catCurrent} dari ${catPageEls.length}`;
    renderCatNumbers();
    const active = catPageEls[catCurrent - 1];
    if (!active) return;
    const ad1 = document.getElementById('cat-ad-1');
    if (ad1) {
      const cards = active.querySelectorAll('.brutal-card');
      if (cards.length > 3) active.insertBefore(ad1, cards[3]);
      else active.appendChild(ad1);
    }
  }

  catPagesBox?.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-cat-go]');
    if (btn) showCatPage(Number(btn.getAttribute('data-cat-go')));
  });
  if (catPageEls.length) showCatPage(1);
</script>
