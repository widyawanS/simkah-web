---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import PostCard from "@components/blog/PostCard.astro";
import { getPosts } from "@lib/content.ts";

const allPosts = await getPosts();

// --- Pagination ---
const pageSize = 9;
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const start = (page - 1) * pageSize;
const posts = allPosts.slice(start, start + pageSize);
const totalPages = Math.ceil(allPosts.length / pageSize);

// Halaman yang akan ditampilkan di navigasi (1, ..., 4, 5, 6, ..., 12)
const visiblePages: (number | null)[] = [];
let lastShown: number | null = null;
for (let p = 1; p <= totalPages; p++) {
    const show = p === 1 || p === totalPages || Math.abs(p - page) <= 2;
    if (show) {
        if (lastShown !== null && p > lastShown + 1) visiblePages.push(null); // ellipsis …
        visiblePages.push(p);
        lastShown = p;
    }
}

const pageUrl = (p: number) => (p === 1 ? '/blog' : `/blog?page=${p}`);
---

<Layout title="Berita | Insights & Stories">
  <Container>
    <main class="py-20 animate-fade-in">
      <header class="text-center mb-20">
          <h1 class="text-5xl font-bold mb-6 tracking-tighter">Berita & <span class="text-gradient">Informasi</span></h1>
          <p class="text-slate-400 max-w-xl mx-auto text-lg">Eksplorasi mendalam tentang teknologi, kreativitas, dan alat produktivitas masa depan.</p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          posts.map((post, index) => (
            <PostCard post={post} index={index} />
          ))
        }
      </div>

      {posts.length === 0 && (
         <div class="text-center py-20 glass rounded-[3rem]">
            <p class="text-slate-500 italic">Belum ada artikel yang dipublikasikan.</p>
            <a href="/keystatic" class="mt-4 inline-block text-brand-primary font-bold">Mulai nulis di Admin →</a>
         </div>
      )}

      <!-- Pagination -->
      {totalPages > 1 && (
        <nav class="mt-16 flex flex-wrap justify-center items-center gap-2">
          {page > 1 && (
            <a href={pageUrl(page - 1)} class="brutal-pill px-6 py-2.5 text-sm font-extrabold uppercase tracking-wider text-brutal-text hover:bg-brand-primary hover:text-white transition-colors shadow-brutal-sm hover:shadow-brutal active:translate-y-[1px]">
              ← Sebelumnya
            </a>
          )}

          {visiblePages.map((p, i) => {
            if (p === null) {
              return (
                <span key="ellipsis" class="px-3 py-2.5 text-slate-400 dark:text-slate-600 text-sm font-bold">…</span>
              );
            }
            const isCurrent = p === page;
            return (
              <a
                key={p}
                href={pageUrl(p)}
                class={`brutal-pill px-5 py-2.5 text-sm font-extrabold uppercase tracking-wider transition-colors shadow-brutal-sm active:translate-y-[1px] ${isCurrent
                  ? 'bg-brutal-border text-white shadow-brutal'
                  : 'text-brutal-text hover:bg-brand-primary hover:text-white'}`}
              >
                {p}
              </a>
            );
          })}

          {page < totalPages && (
            <a href={pageUrl(page + 1)} class="brutal-pill px-6 py-2.5 text-sm font-extrabold uppercase tracking-wider text-brutal-text hover:bg-brand-primary hover:text-white transition-colors shadow-brutal-sm hover:shadow-brutal active:translate-y-[1px]">
              Selanjutnya →
            </a>
          )}
        </nav>
      )}
    </main>
  </Container>
</Layout>
