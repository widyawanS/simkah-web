---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import { getPosts } from "@lib/content.ts";
import { getHomepage } from "@lib/keystatic";
import AdSlot from "@components/ui/AdSlot.astro";
import { Image } from "astro:assets";

const latestPosts = await getPosts();
const featuredPost = latestPosts[0];
const newsPosts = latestPosts;
const newsPageSize = 6;
const newsPages = [];
for (let i = 0; i < newsPosts.length; i += newsPageSize) {
  newsPages.push(newsPosts.slice(i, i + newsPageSize));
}
const totalNewsPages = newsPages.length;
const homepageData = await getHomepage();

const heroTitle = homepageData?.heroTitle || "Build with Intelligence";
const heroSubtitle = homepageData?.heroSubtitle || "Kumpulan artikel mendalam, alat produktivitas pintar, dan generator prompt untuk masa depan kreatif Anda.";
const heroButtonText = homepageData?.heroButtonText;
const heroButtonLink = homepageData?.heroButtonLink;

const categories = [
  { title: "Berita", path: "/category/berita" },
  { title: "Panduan Operator", path: "/category/panduan-operator" },
  { title: "Catatan", path: "/category/catatan" },
];
---

<Layout title="simkah.web.id" heroImage={featuredPost?.image}>
  <main>
    <!-- Hero: Corridor. One centred column, the search bar carries the filters. -->
    <section class="guide-hero">
      <Container>
        <div class="hero-corridor">
          <h1>{heroTitle}</h1>
          <p class="lead">{heroSubtitle.replace("Gratis selamanya.", "")} Gratis selamanya.</p>

          <div class="guide-search hero-search">
            <div class="hero-search__field relative min-w-0">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-brutal-text-muted" aria-hidden="true">
                <svg class="w-5 h-5 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                </svg>
              </span>
              <button class="search-btn-trigger w-full text-left bg-brutal-bg-alt rounded-brutal py-3 pl-14 pr-6 font-bold text-brutal-text-muted text-base border-2 border-transparent hover:border-brutal-border whitespace-nowrap" aria-label="Cari syarat, biaya, atau panduan nikah…">
                <span class="hidden md:inline whitespace-nowrap">Cari syarat, biaya, atau panduan nikah…</span>
              </button>
            </div>
            <div class="hero-search__filters flex flex-wrap gap-2" aria-label="Kategori">
              {categories.map((category) => (
                <a href={category.path} class="filter-chip">{category.title}</a>
              ))}
            </div>
            {heroButtonText && (
              <a href={heroButtonLink || "#"} class="brutal-btn brutal-btn-accent px-6">
                {heroButtonText}
              </a>
            )}
          </div>

          <div class="flex flex-wrap items-center justify-center gap-6 mt-5 text-sm text-brutal-text-muted">
            <span>Tanpa login</span>
            <span class="h-4 w-px bg-brutal-border" aria-hidden="true"></span>
            <span>Akses instan</span>
          </div>
        </div>
      </Container>
    </section>

    <!-- The feed: six cards per page, the category's own content. -->
    <section class="pt-12 pb-20">
      <Container>
        <div class="news-pages">
          {newsPages.map((pagePosts, pageIndex) => (
            <div class="guide-posts" data-news-page={pageIndex + 1} hidden={pageIndex > 0}>
              {pagePosts.map((post, index) => (
                <article class={`guide-post guide-post--${(index % 3) + 1}`}>
                  <a href={`/blog/${post.slug}`} class="block">
                    {post.image && (
                      typeof post.image === 'string' ? (
                        <img src={post.image} width={600} height={375} class="w-full" alt={post.title} loading={pageIndex === 0 && index === 0 ? 'eager' : 'lazy'} decoding="async" fetchpriority={pageIndex === 0 && index === 0 ? 'high' : undefined} />
                      ) : (
                        <Image src={post.image} width={600} height={375} class="w-full" alt={post.title} loading={pageIndex === 0 && index === 0 ? 'eager' : 'lazy'} decoding="async" fetchpriority={pageIndex === 0 && index === 0 ? 'high' : undefined} />
                      )
                    )}
                    <div class="guide-post__body">
                      <nav class="guide-post__label" aria-label="Kategori artikel"><span class="tag">{post.category}</span></nav>
                      <h3>{post.title}</h3>
                      <time datetime={post.pubDate.toISOString()} class="post-date">{post.pubDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}</time>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          ))}
        </div>

        <div id="feed-ad" class="feed-ad">
          <AdSlot type="home-2" />
        </div>
        <div id="feed-ad-2" class="feed-ad">
          <AdSlot type="home" />
        </div>

        {totalNewsPages > 1 && (
          <nav class="news-pagination mt-10 flex flex-wrap items-center justify-center gap-2" aria-label="Halaman artikel">
            <span class="flex flex-wrap items-center justify-center gap-2" data-news-pages></span>
            <span class="visually-hidden" role="status" aria-live="polite" data-news-status>Halaman 1 dari {totalNewsPages}</span>
          </nav>
        )}

      </Container>
    </section>

  </main>
</Layout>

<script>
  const newsPageEls = Array.from(document.querySelectorAll('[data-news-page]'));
  const newsStatus = document.querySelector('[data-news-status]');
  const newsPagesBox = document.querySelector('[data-news-pages]');
  let newsCurrent = 1;

  function renderNewsNumbers() {
    if (!newsPagesBox) return;
    const total = newsPageEls.length;
    // Reference pattern: four numbers with "…" always between numbers, e.g. 1 2 3 … 8.
    let items;
    if (total <= 4) {
      items = Array.from({ length: total }, (_, i) => i + 1);
    } else if (newsCurrent <= 2) {
      items = [1, 2, 3, 'gap', total];
    } else if (newsCurrent >= total - 2) {
      items = [1, 'gap', total - 2, total - 1, total];
    } else {
      items = [1, newsCurrent, newsCurrent + 1, 'gap', total];
    }
    let html = '';
    for (const item of items) {
      if (item === 'gap') html += '<span class="page-gap" aria-hidden="true">…</span>';
      else html += `<button type="button" class="page-num${item === newsCurrent ? ' is-current' : ''}" data-news-go="${item}"${item === newsCurrent ? ' aria-current="page"' : ''}>${item}</button>`;
    }
    newsPagesBox.innerHTML = html;
  }

  function showNewsPage(n) {
    newsCurrent = Math.min(Math.max(n, 1), newsPageEls.length);
    newsPageEls.forEach((el, i) => { el.hidden = i + 1 !== newsCurrent; });
    if (newsStatus) newsStatus.textContent = `Halaman ${newsCurrent} dari ${newsPageEls.length}`;
    renderNewsNumbers();
    const activePage = newsPageEls[newsCurrent - 1];
    if (activePage) {
      const cards = activePage.querySelectorAll('.guide-post');
      const ad1 = document.getElementById('feed-ad');
      const ad2 = document.getElementById('feed-ad-2');
      if (ad1) {
        if (cards.length > 3) activePage.insertBefore(ad1, cards[3]);
        else activePage.appendChild(ad1);
      }
      if (ad2) activePage.appendChild(ad2);
    }
  }

  newsPagesBox?.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-news-go]');
    if (btn) showNewsPage(Number(btn.getAttribute('data-news-go')));
  });
  showNewsPage(1);
</script>

<style>
  h1, h2, h3 { overflow-wrap: break-word; min-width: 0; text-wrap: balance; }
</style>
