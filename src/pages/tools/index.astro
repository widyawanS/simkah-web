---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import AdSlot from "@components/ui/AdSlot.astro";
import { getAllTools } from "@lib/keystatic";

// Get all tools from Keystatic
const allTools = await getAllTools();

const getToolCategoryColor = (cat: string) => {
  const c = cat?.toLowerCase() || '';
  if (c === 'calculator') return 'bg-[#c0e6ff] text-slate-900 dark:bg-sky-950/80 dark:text-sky-200 dark:border-sky-700';
  if (c === 'generator') return 'bg-[#fae870] text-slate-900 dark:bg-amber-950/80 dark:text-amber-200 dark:border-amber-700';
  if (c === 'converter') return 'bg-pink-200 text-slate-900 dark:bg-pink-950/80 dark:text-pink-200 dark:border-pink-700';
  return 'bg-emerald-200 text-slate-900 dark:bg-emerald-950/80 dark:text-emerald-200 dark:border-emerald-700';
};
---

<Layout title="Tools & Calculators - Kumpulan Alat Produktivitas Nikah">
  <Container>
    <div class="mt-8 mb-6">
      <Sectionhead>
        <Fragment slot="title">Tools & Calculators</Fragment>
        <Fragment slot="desc">Kumpulan alat interaktif resmi untuk mempermudah persiapan administrasi pernikahan Anda</Fragment>
      </Sectionhead>
    </div>

    <AdSlot type="tools" />

    <div class="grid md:grid-cols-2 gap-8 mt-12 max-w-5xl mx-auto">
      <!-- Hardcoded: Cek Berkas Catin -->
      <a
        href="/tools/cek-berkas"
        class="group relative brutal-card rounded-3xl p-8 transition-all duration-300 bg-[#e8dff5] dark:bg-slate-900 border-3 border-brutal-border hover:-translate-y-1.5 hover:shadow-brutal-lg flex flex-col justify-between">
        <div>
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-3xl mb-6 bg-purple-500/10 dark:bg-purple-500/20 border-2 border-purple-500/30">
            ✅
          </div>
          <h3 class="text-2xl font-black mb-3 text-slate-900 dark:text-white group-hover:text-purple-700 dark:group-hover:text-purple-400 transition-colors">
            Cek Berkas Catin
          </h3>
          <p class="text-slate-800 dark:text-slate-300 leading-relaxed font-semibold">
            Cek kelengkapan berkas layanan KUA berdasarkan Kepdirjen 888/2026: pilih layanan, centang dokumen, dan ketahui syarat yang belum lengkap.
          </p>
        </div>

        <div class="pt-6 border-t border-slate-900/10 dark:border-slate-800 flex items-center justify-between mt-6">
          <span class="text-[11px] px-3.5 py-1.5 rounded-full font-extrabold uppercase tracking-widest border-2 border-brutal-border bg-[#d8ccf0] text-slate-900 dark:bg-purple-950 dark:text-purple-200 dark:border-purple-700 shadow-sm">
            Checklist
          </span>
          <div class="flex items-center gap-1.5 text-sm font-black text-slate-900 dark:text-purple-400 group-hover:translate-x-1 transition-transform">
            <span>Buka Tool</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </div>
        </div>
      </a>

      <!-- Hardcoded: Penelusuran Perkara -->
      <a 
        href="/tools/penelusuran-perkara" 
        class="group relative brutal-card rounded-3xl p-8 transition-all duration-300 bg-emerald-200 dark:bg-slate-900 border-3 border-brutal-border hover:-translate-y-1.5 hover:shadow-brutal-lg flex flex-col justify-between">
        <div>
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-3xl mb-6 bg-emerald-500/10 dark:bg-emerald-500/20 border-2 border-emerald-500/30">
            ⚖️
          </div>
          <h3 class="text-2xl font-black mb-3 text-slate-900 dark:text-white group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">
            Penelusuran Perkara
          </h3>
          <p class="text-slate-800 dark:text-slate-300 leading-relaxed font-semibold">
            Cari informasi perkara resmi dari seluruh Pengadilan Agama dan Mahkamah Syar'iyah di Indonesia langsung dari basis data SIPP.
          </p>
        </div>

        <div class="pt-6 border-t border-slate-900/10 dark:border-slate-800 flex items-center justify-between mt-6">
          <span class="text-[11px] px-3.5 py-1.5 rounded-full font-extrabold uppercase tracking-widest border-2 border-brutal-border bg-emerald-300 text-slate-900 dark:bg-emerald-950 dark:text-emerald-200 dark:border-emerald-700 shadow-sm">
            Lookup
          </span>
          <div class="flex items-center gap-1.5 text-sm font-black text-slate-900 dark:text-emerald-400 group-hover:translate-x-1 transition-transform">
            <span>Buka Tool</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </div>
        </div>
      </a>

      <!-- Tools from Keystatic / List -->
      {allTools.map((tool, i) => {
        const bgColors = ['bg-[#fae870]', 'bg-[#c0e6ff]', 'bg-[#f8ddb2]', 'bg-[#e8dff5]', 'bg-[#bbf7d0]', 'bg-[#ffcdd2]'];
        const cardBg = bgColors[i % bgColors.length];
        return (
        <a 
          href={tool?.isActive ? tool?.link : "#"} 
          class:list={[
            "group relative brutal-card rounded-3xl p-8 transition-all duration-300 border-3 border-brutal-border flex flex-col justify-between",
            cardBg,
            "dark:bg-slate-900",
            !tool?.isActive ? "opacity-60 cursor-not-allowed" : "hover:-translate-y-1.5 hover:shadow-brutal-lg"
          ]}>
          
          {!tool?.isActive && (
            <span class="absolute top-4 right-4 px-3 py-1 text-[10px] font-black uppercase tracking-widest bg-slate-900 text-white dark:bg-slate-800 dark:text-slate-300 rounded-full border-2 border-brutal-border shadow-sm">
              Coming Soon
            </span>
          )}
          
          <div>
            <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-3xl mb-6 bg-slate-900/10 dark:bg-slate-800 border-2 border-slate-900/20 dark:border-slate-700">
              {tool?.icon || '🔧'}
            </div>
            
            <h3 class:list={[
              "text-2xl font-black mb-3 transition-colors text-slate-900 dark:text-white",
              tool?.isActive && "group-hover:text-blue-700 dark:group-hover:text-sky-400"
            ]}>
              {tool?.title || tool?.slug || 'Tool'}
            </h3>
            
            <p class="text-slate-800 dark:text-slate-300 leading-relaxed font-semibold">
              {tool?.shortDescription || 'Deskripsi alat produktivitas'}
            </p>
          </div>

          <div class="pt-6 border-t border-slate-900/10 dark:border-slate-800 flex items-center justify-between mt-6">
            <span class={`text-[11px] px-3.5 py-1.5 rounded-full font-extrabold uppercase tracking-widest border-2 border-brutal-border shadow-sm ${getToolCategoryColor(tool?.category || 'other')}`}>
              {tool?.category || 'other'}
            </span>
            
            {tool?.isActive && (
              <div class="flex items-center gap-1.5 text-sm font-black text-slate-900 dark:text-sky-400 group-hover:translate-x-1 transition-transform">
                <span>Buka Tool</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </div>
            )}
          </div>
        </a>
        );
      })}
    </div>

    <!-- Stats Section -->
    <div class="mt-20 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
      <div class="brutal-card bg-[#fae870] dark:bg-slate-900 rounded-2xl p-6 text-center border-3 border-brutal-border">
        <p class="text-4xl font-black text-slate-900 dark:text-amber-400">{allTools.filter(t => t?.isActive).length + 2}</p>
        <p class="text-sm font-bold text-slate-800 dark:text-slate-300 mt-1">Active Tools</p>
      </div>
      <div class="brutal-card bg-[#c0e6ff] dark:bg-slate-900 rounded-2xl p-6 text-center border-3 border-brutal-border">
        <p class="text-4xl font-black text-slate-900 dark:text-sky-400">100%</p>
        <p class="text-sm font-bold text-slate-800 dark:text-slate-300 mt-1">Free to Use</p>
      </div>
      <div class="brutal-card bg-[#f8ddb2] dark:bg-slate-900 rounded-2xl p-6 text-center border-3 border-brutal-border">
        <p class="text-4xl font-black text-slate-900 dark:text-orange-400">0</p>
        <p class="text-sm font-bold text-slate-800 dark:text-slate-300 mt-1">Data Stored</p>
      </div>
      <div class="brutal-card bg-[#e8dff5] dark:bg-slate-900 rounded-2xl p-6 text-center border-3 border-brutal-border">
        <p class="text-4xl font-black text-slate-900 dark:text-purple-400">∞</p>
        <p class="text-sm font-bold text-slate-800 dark:text-slate-300 mt-1">Simulations</p>
      </div>
    </div>
  </Container>
</Layout>
