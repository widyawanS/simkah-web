---

<Layout
  title="Cek Berkas Catin KUA - Kelengkapan Dokumen Kepdirjen 888/2026"
  description="Pilih layanan KUA, centang dokumen yang sudah ada, dan lihat yang kurang beserta dasar rujukannya. Berdasarkan Kepdirjen Bimas Islam No. 888/2026. Gratis."
>
  <script type="application/ld+json" slot="head" set:html={toolJsonLd} />
  <Container>
    <div class="text-center mb-12 mt-12 flex flex-col items-center">
      <span class="inline-block px-4 py-2 brutal-badge bg-[#e8dff5] text-brutal-text text-sm font-bold mb-4 border-2 border-brutal-border">
        ✅ Cek Berkas
      </span>
      <h1 class="text-3xl md:text-5xl font-black text-brutal-text text-center mb-4 drop-shadow-md">
        Cek Berkas <span class="text-purple-500">Catin KUA</span>
      </h1>
      <p class="text-center text-brutal-text-muted max-w-2xl mx-auto mb-8 text-lg font-medium">
        Pilih layanan, centang dokumen yang sudah ada — yang kurang langsung kelihatan, beserta dasar rujukannya dari Kepdirjen 888/2026.
      </p>
      <AdSlot type="tools" />
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="brutal-card bg-[#e8dff5] dark:bg-brutal-card rounded-3xl p-6 md:p-10">
        <label for="layananSelect" class="block text-sm font-extrabold uppercase tracking-widest text-brutal-text-muted mb-2">Pilih Layanan</label>
        <select
          id="layananSelect"
          class="w-full rounded-2xl border-2 border-brutal-border bg-white dark:bg-slate-800 px-4 py-3 text-base font-bold text-brutal-text focus:outline-none focus:ring-4 focus:ring-purple-300"
        >
          {LAYANAN.map((l) => (
            <option value={l.id}>{l.nomor} — {l.nama}</option>
          ))}
        </select>

        <div class="mt-6 grid sm:grid-cols-3 gap-3">
          <div class="rounded-2xl border-2 border-brutal-border bg-white dark:bg-slate-800 p-4">
            <p class="text-[10px] font-extrabold uppercase tracking-widest text-brutal-text-muted mb-1">Waktu Standar</p>
            <p id="infoWaktu" class="text-sm font-bold text-brutal-text"></p>
          </div>
          <div class="rounded-2xl border-2 border-brutal-border bg-white dark:bg-slate-800 p-4">
            <p class="text-[10px] font-extrabold uppercase tracking-widest text-brutal-text-muted mb-1">Biaya</p>
            <p id="infoBiaya" class="text-sm font-bold text-brutal-text"></p>
          </div>
          <div class="rounded-2xl border-2 border-brutal-border bg-white dark:bg-slate-800 p-4">
            <p class="text-[10px] font-extrabold uppercase tracking-widest text-brutal-text-muted mb-1">Produk Pelayanan</p>
            <p id="infoProduk" class="text-sm font-bold text-brutal-text"></p>
          </div>
        </div>

        <!-- Progress -->
        <div class="mt-6">
          <div class="flex justify-between items-end mb-2">
            <p class="text-sm font-extrabold uppercase tracking-widest text-brutal-text-muted">Berkas lengkap</p>
            <p id="progressText" class="text-sm font-black text-brutal-text">0 / 0</p>
          </div>
          <div class="h-4 rounded-full border-2 border-brutal-border bg-white dark:bg-slate-800 overflow-hidden">
            <div id="progressBar" class="h-full bg-emerald-400 transition-all duration-300" style="width: 0%"></div>
          </div>
        </div>

        <!-- Checklist -->
        <div id="checklistBox" class="mt-6 space-y-2"></div>

        <!-- Hasil -->
        <div id="resultBox" class="mt-6 rounded-2xl border-2 border-brutal-border bg-white dark:bg-slate-800 p-5 hidden">
          <p id="resultTitle" class="font-black text-lg mb-1"></p>
          <p id="resultDesc" class="text-sm text-brutal-text-muted leading-relaxed"></p>
        </div>

        <div class="mt-6 flex flex-wrap gap-3">
          <button
            type="button"
            id="btnReset"
            class="brutal-pill px-5 py-3 text-sm font-bold text-brutal-text hover:bg-white transition-colors shadow-brutal-sm active:translate-y-[1px]"
          >
            Reset Centangan
          </button>
          <a
            id="btnArtikel"
            href="/blog/panduan-operator-kepdirjen-888-2026"
            class="brutal-pill px-5 py-3 text-sm font-bold text-brutal-text bg-white dark:bg-slate-800 border-2 border-brutal-border hover:bg-brand-primary hover:text-white transition-colors shadow-brutal-sm"
          >
            Baca panduan lengkap →
          </a>
        </div>

        <p class="mt-6 text-xs text-brutal-text-muted leading-relaxed">
          Dasar data: Kepdirjen Bimas Islam No. 888 Tahun 2026 tentang Standar Pelayanan KUA. Alat ini membantu pengecekan awal — verifikasi resmi tetap dilakukan petugas KUA atas dokumen fisik/asli.
        </p>
      </div>
    </div>
  </Container>
  <RelatedGuides
    title="Panduan operator terkait"
    links={[
      { href: "/blog/panduan-operator-kepdirjen-888-2026", label: "Ringkasan Kepdirjen 888/2026" },
      { href: "/blog/checklist-operator-kehendak-nikah-888", label: "Checklist Kehendak Nikah" },
      { href: "/blog/peta-regulasi-permenag-30-2024-kepdirjen-888", label: "Peta Regulasi" },
    ]}
  />
  <script type="application/json" id="layananData" set:html={toJsonLd(LAYANAN)} />
</Layout>

<script>
  const LAYANAN = JSON.parse(document.getElementById("layananData").textContent);

  const els = {
    select: document.getElementById("layananSelect"),
    waktu: document.getElementById("infoWaktu"),
    biaya: document.getElementById("infoBiaya"),
    produk: document.getElementById("infoProduk"),
    bar: document.getElementById("progressBar"),
    text: document.getElementById("progressText"),
    checklist: document.getElementById("checklistBox"),
    result: document.getElementById("resultBox"),
    resultTitle: document.getElementById("resultTitle"),
    resultDesc: document.getElementById("resultDesc"),
    reset: document.getElementById("btnReset"),
    artikel: document.getElementById("btnArtikel"),
  };

  const esc = (s = "") =>
    s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

  const current = () => LAYANAN.find((l) => l.id === els.select.value) || LAYANAN[0];

  function render() {
    const l = current();

    els.waktu.textContent = l.waktu;
    els.biaya.textContent = l.biaya;
    els.produk.textContent = l.produk;
    els.artikel.href = l.artikel;

    els.checklist.innerHTML = l.items
      .map(
        (item, i) => `
      <label class="flex items-start gap-3 rounded-2xl border-2 border-brutal-border bg-white dark:bg-slate-800 px-4 py-3 cursor-pointer transition-colors hover:bg-brand-primary/10">
        <input
          type="checkbox"
          data-idx="${i}"
          class="mt-0.5 w-5 h-5 shrink-0 accent-emerald-500 cursor-pointer"
        />
        <span class="text-sm font-bold text-brutal-text leading-relaxed">${esc(item)}</span>
      </label>`
      )
      .join("");

    update();
  }

  function update() {
    const l = current();
    const boxes = [...els.checklist.querySelectorAll("input[type='checkbox']")];
    const checked = boxes.filter((b) => b.checked).length;
    const total = boxes.length;

    boxes.forEach((b) => {
      const label = b.closest("label");
      if (b.checked) {
        label.classList.add("opacity-60");
        label.classList.add("line-through");
      } else {
        label.classList.remove("opacity-60");
        label.classList.remove("line-through");
      }
    });

    const pct = total ? Math.round((checked / total) * 100) : 0;
    els.bar.style.width = pct + "%";
    els.text.textContent = `${checked} / ${total}`;

    if (checked === 0) {
      els.result.classList.add("hidden");
      return;
    }

    els.result.classList.remove("hidden");
    if (checked === total) {
      els.resultTitle.textContent = "✅ Berkas lengkap!";
      els.resultTitle.className = "font-black text-lg mb-1 text-emerald-600";
      els.resultDesc.textContent =
        "Semua dokumen sesuai daftar persyaratan " +
        l.nomor +
        ". Verifikasi resmi tetap dilakukan petugas KUA atas dokumen asli — siapkan aslinya untuk dicocokkan.";
    } else {
      const kurang = l.items.filter((_, i) => !boxes[i].checked);
      els.resultTitle.textContent = `⏳ Kurang ${kurang.length} dokumen`;
      els.resultTitle.className = "font-black text-lg mb-1 text-orange-500";
      els.resultDesc.innerHTML =
        "Yang belum tercentang: " + kurang.map((k) => `• ${esc(k)}`).join(" — ");
    }
  }

  els.select.addEventListener("change", render);
  els.checklist.addEventListener("change", (e) => {
    if (e.target.matches("input[type='checkbox']")) update();
  });
  els.reset.addEventListener("click", () => {
    els.checklist
      .querySelectorAll("input[type='checkbox']")
      .forEach((b) => (b.checked = false));
    update();
  });

  render();
</script>

