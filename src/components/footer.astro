  <Container>
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-5 text-sm text-brutal-text-muted">
      <p>© {year} SIMKAH.WEB.ID. All rights reserved. Bagian dari inisiatif digital keluarga Sakinah.</p>
      <div class="flex flex-wrap gap-x-5 gap-y-2">
        <a href="/about">Tentang</a>
        <a href="/disclaimer">Disclaimer</a>
        <a href="/privacy-policy">Privasi</a>
        <a href="/contact">Kontak</a>
      </div>
    </div>
  </Container>
</footer>
