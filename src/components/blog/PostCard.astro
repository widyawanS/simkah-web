---
import { Image } from "astro:assets";
import type { BlogPost } from "@lib/content";
import blogImages from "../../data/blog-images";

const CARD_SIZES = "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw";
const cardSrcSet = (src: string) => {
    const meta = blogImages[src];
    return meta?.variants?.length
        ? meta.variants.map((w) => `${src.replace(/\.[a-z0-9]+$/i, `-${w}.webp`)} ${w}w`).join(", ")
        : undefined;
};

interface Props {
    post: BlogPost;
    index?: number;
    compact?: boolean;
}

const { post, index = 0, compact = false } = Astro.props;

const isString = typeof post.image === 'string';
const hasImage = Boolean(post.image);
---
<article class="group relative flex flex-col brutal-card overflow-hidden border-brutal-border shadow-brutal-sm transition-shadow duration-300 bg-brutal-card">
    <a href={`/blog/${post.slug}`} class="flex-1 flex flex-col">
        <div class="aspect-[16/10] overflow-hidden relative bg-brutal-bg-alt border-b-3 border-brutal-border">
            {hasImage ? (
                isString ? (
                    <img
                        src={post.image}
                        srcset={cardSrcSet(post.image)}
                        sizes={CARD_SIZES}
                        alt={post.title}
                        loading={index < 2 ? "eager" : "lazy"}
                        class="w-full h-full object-cover"
                    />
                ) : (
                    <Image
                        src={post.image}
                        alt={post.title}
                        loading={index < 2 ? "eager" : "lazy"}
                        width={600}
                        height={338}
                        class="w-full h-full object-cover"
                    />
                )
            ) : (
                <div class="w-full h-full flex items-center justify-center bg-brutal-bg-alt text-3xl font-bold text-brutal-text">
                    {post.title.trim()[0].toUpperCase()}
                </div>
            )}
        </div>

        <div class="postcard__body p-4 flex flex-col flex-grow">
            <nav class="postcard__label" aria-label="Kategori artikel"><span class="postcard-tag">{post.category || 'Umum'}</span></nav>
            <h2 class="text-lg font-bold mb-2 leading-tight text-brutal-text">
                {post.title}
            </h2>
            {!compact && (
                <p class="text-brutal-text-muted text-sm leading-relaxed mb-auto">
                    {post.description || ''}
                </p>
            )}
        </div>
    </a>
</article>
