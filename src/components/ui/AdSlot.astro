---
import { getSiteSettings } from "@lib/keystatic";

export interface Props {
  type: 'home' | 'home-2' | 'post' | 'post-2' | 'tools';
  class?: string;
}

const { type, class: className } = Astro.props;
const settings = await getSiteSettings();
const ads = settings?.ads || { isActive: false };

const slotIds: Record<Props['type'], string> = {
  home: ads.homeAd,
  'home-2': ads.homeAd2,
  post: ads.postAd,
  'post-2': ads.postAd2,
  tools: ads.toolsAd,
};
const slotId = slotIds[type];
---

{ads.isActive && ads.adClient && slotId && (
  <div class={`ad-container text-center ${className || ''}`} data-ad-container>
    <span class="ad-label text-sm text-brutal-text-muted block mb-2">Advertisement</span>
    <div class="ad-frame w-full flex items-center justify-center overflow-hidden">
      <ins class="adsbygoogle"
          style="display:block; min-width:250px; min-height:90px"
          data-ad-client={ads.adClient}
          data-ad-slot={slotId}
          data-ad-format="auto"
          data-full-width-responsive="true"></ins>
      <script is:inline>
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </div>
  </div>
)}

<script>
  function syncAdFrames() {
    document.querySelectorAll('[data-ad-container]').forEach(function (wrap) {
      var ins = wrap.querySelector('ins.adsbygoogle');
      if (!ins) return;
      var status = ins.getAttribute('data-ad-status');
      var iframe = ins.querySelector('iframe');
      var filled = status === 'filled' && !!iframe && iframe.getBoundingClientRect().height > 4;
      wrap.classList.toggle('is-filled', !!filled);
      wrap.classList.toggle('is-unfilled', status === 'unfilled');
    });
  }

  function initAdFrames() {
    syncAdFrames();
    if (!('MutationObserver' in window)) return;
    var observer = new MutationObserver(syncAdFrames);
    document.querySelectorAll('ins.adsbygoogle').forEach(function (ins) {
      observer.observe(ins, { attributes: true, childList: true, subtree: true });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAdFrames);
  } else {
    initAdFrames();
  }
  window.addEventListener('load', syncAdFrames);
</script>
