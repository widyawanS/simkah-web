---
import { getSiteSettings } from "@lib/keystatic";
import { SITE, ORG_ID, WEBSITE_ID, toJsonLd } from "@lib/site";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: URL;
  ogType?: string;
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  canonicalURL,
  ogType = "website",
  author,
  publishedTime,
  modifiedTime,
  section,
  noindex = false,
} = Astro.props;

// Normalisasi canonical: buang trailing slash (kecuali root) supaya
// /about dan /about/ tidak menjadi dua URL yang saling self-canonical.
const rawPath = Astro.url.pathname;
const normalizedPath = rawPath.length > 1 ? rawPath.replace(/\/+$/, "") : rawPath;
const canonical = canonicalURL ?? new URL(normalizedPath, Astro.site);

const settings = await getSiteSettings();

// Fallback data if settings are not set in Keystatic yet
const metadata = settings?.metadata || {
  siteName: "SIMKAH Tools",
  description: "Kumpulan tool gratis untuk membantu urusan SIMKAH dan pernikahan.",
  ogImage: "/opengraph.jpg"
};
const ads = settings?.ads || { isActive: false };
const analytics = settings?.analytics || {};

const seoTitle = title ? `${title} | ${metadata.siteName}` : metadata.siteName;
const seoDescription = description || metadata.description;
const seoImage = new URL(image || metadata.ogImage || "/images/og-default.jpg", Astro.site).toString();

const sameAs = [settings?.footer?.telegram, settings?.footer?.facebook].filter(
  (url): url is string => typeof url === "string" && url.startsWith("http")
);

const globalJsonLd = toJsonLd({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": WEBSITE_ID,
      url: `${SITE.url}/`,
      name: metadata.siteName || SITE.name,
      description: seoDescription,
      inLanguage: SITE.language,
      publisher: { "@id": ORG_ID },
    },
    {
      "@type": "Organization",
      "@id": ORG_ID,
      name: metadata.siteName || SITE.name,
      url: `${SITE.url}/`,
      logo: {
        "@type": "ImageObject",
        url: SITE.logo,
      },
      ...(sameAs.length > 0 ? { sameAs } : {}),
    },
  ],
});
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<meta name="profiton-domain-verification" content="50382d253cb280faf75095f4c840222162836e8c38822978e97020858016140c" />
<!-- Canonical URL -->
<link rel="canonical" href={canonical} />

<!-- Resource hints untuk iklan/analytics -->
{ads?.isActive && (
  <>
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
  </>
)}
{analytics.googleAnalyticsId && (
  <>
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
  </>
)}

<!-- Primary Meta Tags -->
<title>{seoTitle}</title>
<meta name="title" content={seoTitle} />
<meta name="description" content={seoDescription} />
<meta
  name="robots"
  content={noindex
    ? "noindex, follow"
    : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
/>
{author && <meta name="author" content={author} />}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{section && <meta property="article:section" content={section} />}
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${metadata.siteName || SITE.name} RSS`}
  href={new URL("/rss.xml", Astro.site)}
/>

<!-- Adsense Global (Lazy loaded on first user interaction or idle to protect Core Web Vitals) -->
{ads.isActive && ads.adClient && (
  <script is:inline define:vars={{ adClient: ads.adClient }}>
    function loadAdsense() {
      if (window.adsenseLoaded) return;
      window.adsenseLoaded = true;
      const adScript = document.createElement('script');
      adScript.src = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adClient}`;
      adScript.async = true;
      adScript.crossOrigin = "anonymous";
      document.head.appendChild(adScript);
    }
    const adTimer = setTimeout(loadAdsense, 3500);
    const adEvents = ['mousedown', 'mousemove', 'keydown', 'touchstart', 'scroll'];
    adEvents.forEach(event => {
      window.addEventListener(event, () => {
        clearTimeout(adTimer);
        loadAdsense();
      }, { once: true, passive: true });
    });
  </script>
)}

<!-- Custom Injected Header -->
{ads.customInjectedHeader && <Fragment set:html={ads.customInjectedHeader} />}

<!-- Analytics (Optimized Loading) -->
{(analytics.googleAnalyticsId || analytics.umamiWebsiteId) && (
  <script is:inline define:vars={{ gaId: analytics.googleAnalyticsId, umamiId: analytics.umamiWebsiteId }}>
    function loadAnalytics() {
      if (window.analyticsLoaded) return;
      
      // Google Analytics
      if (gaId) {
        const gaScript = document.createElement('script');
        gaScript.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
        gaScript.async = true;
        document.head.appendChild(gaScript);
        
        gaScript.onload = () => {
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        };
      }
      
      // Umami
      if (umamiId) {
        const umamiScript = document.createElement('script');
        umamiScript.src = "https://cloud.umami.is/script.js";
        umamiScript.async = true;
        umamiScript.defer = true;
        umamiScript.setAttribute('data-website-id', umamiId);
        document.head.appendChild(umamiScript);
      }
      
      window.analyticsLoaded = true;
    }

    // Load after 5 seconds or on user interaction
    const analyticsTimer = setTimeout(loadAnalytics, 5000);
    const analyticsEvents = ['mousedown', 'mousemove', 'keydown', 'touchstart', 'scroll'];
    
    analyticsEvents.forEach(event => {
      window.addEventListener(event, () => {
        clearTimeout(analyticsTimer);
        loadAnalytics();
      }, { once: true, passive: true });
    });
  </script>
)}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={seoTitle} />
<meta property="og:description" content={seoDescription} />
<meta property="og:image" content={seoImage} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonical} />
<meta property="twitter:title" content={seoTitle} />
<meta property="twitter:description" content={seoDescription} />
<meta property="twitter:image" content={seoImage} />

<!-- Structured Data: WebSite + Organization -->
<script type="application/ld+json" set:html={globalJsonLd} />

<!-- Theme Script (Prevent Flash) -->
<script is:inline>
  const theme = (() => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme');
    }
    // Default to 'dark' for this site
    return 'dark';
  })();
  
  if (theme === 'dark') {
    document.documentElement.classList.add('dark');
  } else {
    document.documentElement.classList.remove('dark');
  }
  window.localStorage.setItem('theme', theme);
</script>
