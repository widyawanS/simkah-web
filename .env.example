# ── Admin KUA ────────────────────────────────────────────────────────────────
# Salin file ini menjadi .env (lokal) atau set di Coolify > Environment Variables.
# File .env sudah masuk .gitignore, JANGAN pernah di-commit.

# Password login halaman /admin/login
ADMIN_PASSWORD=ganti-dengan-password-kuat

# String acak panjang untuk menandatangani cookie sesi.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=ganti-dengan-64-karakter-acak

# GitHub token agar admin production bisa commit kua-manual.json.
# Fine-grained PAT: Repository access = simkah-web saja,
# Permissions > Contents = Read and write.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Opsional (default sudah sesuai repo ini)
GITHUB_OWNER=widyawanS
GITHUB_REPO=simkah-web
GITHUB_BRANCH=main
